# MongoDB Atlas connection string (required)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/placementos?retryWrites=true&w=majority"

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase Auth — JWT secret from Supabase Dashboard > Settings > API.
# Leave empty to run in local demo mode (single demo user, no login required).
SUPABASE_JWT_SECRET=

# Resend — for morning/night/inactivity emails. Leave empty to disable emails.
RESEND_API_KEY=
EMAIL_FROM="PlacementOS <onboarding@resend.dev>"

# Shared secret protecting /api/cron/* endpoints
CRON_SECRET=change-me
