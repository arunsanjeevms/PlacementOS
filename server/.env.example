# ===== Server =====
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ===== Database =====
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/placementos?retryWrites=true&w=majority

# ===== JWT =====
# Use long random strings (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# Cookie domain (leave empty for localhost)
COOKIE_DOMAIN=

# ===== Email (Resend) =====
# Optional in development — emails are logged to console when missing
RESEND_API_KEY=
EMAIL_FROM=PlacementOS <onboarding@resend.dev>

# ===== Cron =====
# Secret used to authorize external cron pings (e.g. from Render/UptimeRobot)
CRON_SECRET=replace-with-a-random-cron-secret
# Set to "false" to disable in-process scheduling (use external pings instead)
ENABLE_CRON=true
