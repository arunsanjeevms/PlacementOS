generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ------------------------------ Enums ------------------------------

enum TaskScope {
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Repeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  TESTING
  COMPLETED
}

enum CompanyStage {
  WISHLIST
  PREPARING
  APPLIED
  ONLINE_ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
}

enum Track {
  JAVA
  DSA
  APTITUDE
}

enum ResourceType {
  WEBSITE
  PDF
  VIDEO
  YOUTUBE_PLAYLIST
  COURSE
  GITHUB_REPO
  LEETCODE_PROBLEM
  ARTICLE
  DOCUMENTATION
  CHEAT_SHEET
  PRACTICE_PLATFORM
  COMPANY_PREP
}

enum InterviewCategory {
  HR
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  CODING
}

// ------------------------------ Models ------------------------------

model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  supabaseId String   @unique
  email      String   @unique
  name       String?
  avatarUrl  String?
  createdAt  DateTime @default(now())

  settings           Settings?
  tasks              Task[]
  subtasks           Subtask[]
  sessions           StudySession[]
  projects           Project[]
  milestones         Milestone[]
  companies          Company[]
  resources          Resource[]
  notes              Note[]
  folders            Folder[]
  bookmarks          Bookmark[]
  attachments        Attachment[]
  achievements       Achievement[]
  topics             TopicProgress[]
  dayLogs            DayLog[]
  reminderLogs       ReminderLog[]
  interviewQuestions InterviewQuestion[]
  mockInterviews     MockInterview[]
}

model Settings {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @unique @db.ObjectId
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String  @default("dark")
  accentColor        String  @default("violet")
  timezone           String  @default("Asia/Kolkata")
  dailyGoalHours     Float   @default(6)
  focusMinutes       Int     @default(25)
  shortBreakMinutes  Int     @default(5)
  longBreakMinutes   Int     @default(15)
  longBreakEvery     Int     @default(4)
  autoStartBreaks    Boolean @default(false)
  autoStartPomodoros Boolean @default(false)
  soundEnabled       Boolean @default(true)
  morningEmail       Boolean @default(true)
  nightEmail         Boolean @default(true)
  inactivityEmail    Boolean @default(true)
  emailFrequency     String  @default("daily")
  targetRole         String  @default("Software Engineer")
}

model Task {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  userId        String     @db.ObjectId
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String     @default("")
  category      String     @default("Custom")
  priority      Priority   @default(MEDIUM)
  difficulty    Difficulty @default(MEDIUM)
  scope         TaskScope  @default(DAILY)
  status        TaskStatus @default(TODO)
  estimateMin   Int        @default(30)
  actualMin     Int        @default(0)
  deadline      DateTime?
  scheduledFor  String? // YYYY-MM-DD in user's local time
  repeat        Repeat     @default(NONE)
  tags          String[]
  links         String[]
  notes         String     @default("")
  order         Int        @default(0)
  completedDate String? // YYYY-MM-DD set when marked DONE
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  subtasks    Subtask[]
  sessions    StudySession[]
  attachments Attachment[]

  @@index([userId, scope, scheduledFor])
  @@index([userId, status])
}

model Subtask {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  userId String  @db.ObjectId
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String  @db.ObjectId
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
}

model StudySession {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId       String?   @db.ObjectId
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startedAt    DateTime
  endedAt      DateTime?
  durationMin  Int       @default(0)
  dateKey      String // YYYY-MM-DD in user's local time
  subject      String    @default("General")
  preset       String    @default("25/5")
  isPomodoro   Boolean   @default(true)
  notes        String    @default("")
  mood         String    @default("")
  productivity Int       @default(0) // 1-5

  @@index([userId, dateKey])
}

model Project {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  userId      String        @db.ObjectId
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  status      ProjectStatus @default(TODO)
  techStack   String[]
  githubUrl   String        @default("")
  liveUrl     String        @default("")
  deployment  String        @default("")
  deadline    DateTime?
  notes       String        @default("")
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  milestones Milestone[]

  @@index([userId, status])
}

model Milestone {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String    @db.ObjectId
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  order     Int       @default(0)

  @@index([projectId])
}

model Company {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  userId        String       @db.ObjectId
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  stage         CompanyStage @default(WISHLIST)
  eligibility   String       @default("")
  ctc           String       @default("")
  oaPattern     String       @default("")
  rounds        Json         @default("[]") // [{ name, status: "pending"|"cleared"|"failed", notes }]
  questions     Json         @default("[]") // [{ question, topic, link }]
  resources     Json         @default("[]") // [{ title, url }]
  preparation   Int          @default(0) // 0-100
  resumeStatus  String       @default("Not Started")
  applied       Boolean      @default(false)
  interviewDate DateTime?
  notes         String       @default("")
  favorite      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, stage])
}

model Resource {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  userId      String       @db.ObjectId
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteName    String       @default("")
  title       String
  description String       @default("")
  url         String
  type        ResourceType @default(WEBSITE)
  category    String       @default("General")
  tags        String[]
  difficulty  Difficulty   @default(MEDIUM)
  favorite    Boolean      @default(false)
  pinned      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([userId, category])
}

model Folder {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  userId   String  @db.ObjectId
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  parentId String? @db.ObjectId
  order    Int     @default(0)

  notes Note[]

  @@index([userId, parentId])
}

model Note {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId     String?   @db.ObjectId
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  title        String    @default("Untitled")
  content      String    @default("")
  category     String    @default("General")
  tags         String[]
  pinned       Boolean   @default(false)
  favorite     Boolean   @default(false)
  archived     Boolean   @default(false)
  taskId       String?   @db.ObjectId
  projectId    String?   @db.ObjectId
  companyId    String?   @db.ObjectId
  revisionDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookmarks   Bookmark[]
  attachments Attachment[]

  @@index([userId, folderId])
  @@index([userId, updatedAt])
}

model Bookmark {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String?  @db.ObjectId
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title     String
  url       String
  kind      String   @default("link") // youtube | github | leetcode | gfg | docs | drive | linkedin | paper | interview-exp | oa | link
  tags      String[]
  createdAt DateTime @default(now())

  @@index([userId])
}

model Attachment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?  @db.ObjectId
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  noteId    String?  @db.ObjectId
  note      Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  name      String
  url       String
  mimeType  String   @default("")
  createdAt DateTime @default(now())
}

model Achievement {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String // e.g. streak-7, hours-100, tasks-100
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model TopicProgress {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  userId     String @db.ObjectId
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track      Track
  topic      String
  progress   Int    @default(0) // 0-100
  solvedEasy Int    @default(0)
  solvedMed  Int    @default(0)
  solvedHard Int    @default(0)
  solved     Int    @default(0) // aptitude / java questions solved
  accuracy   Int    @default(0) // 0-100 (aptitude)
  avgTimeSec Int    @default(0) // aptitude
  revisions  Int    @default(0)
  weak       Boolean @default(false)
  notes      String @default("")
  bookmarks  Json   @default("[]") // [{ title, url }]
  resources  Json   @default("[]") // [{ title, url }]

  @@unique([userId, track, topic])
}

model DayLog {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  userId  String @db.ObjectId
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey String // YYYY-MM-DD
  journal String @default("")

  @@unique([userId, dateKey])
}

model ReminderLog {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  userId String   @db.ObjectId
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String // morning | night | inactivity
  sentAt DateTime @default(now())

  @@index([userId, type])
}

model InterviewQuestion {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  userId    String            @db.ObjectId
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  answer    String            @default("")
  category  InterviewCategory @default(TECHNICAL)
  company   String            @default("")
  difficulty Difficulty       @default(MEDIUM)
  mastered  Boolean           @default(false)
  favorite  Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, category])
}

model MockInterview {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  type      String   @default("Technical") // Technical | HR | System Design | OA
  company   String   @default("")
  rating    Int      @default(0) // 1-5
  notes     String   @default("")
}
